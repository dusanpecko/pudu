# Canonical origins. No trailing slash. Both are read at build time, so a
# change needs a redeploy.

# Primary domain — the Slovak market, robots.txt, and the fallback for any
# language without a domain of its own. Without it the build falls back to
# VERCEL_PROJECT_PRODUCTION_URL, and to http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=https://pududotoho.sk

# One domain per market. Set these only in production, where the domains exist —
# leaving them unset keeps development and preview deployments on a single host.
#
# They do two jobs: the canonical and hreflang URLs of that language, and the
# front page of that domain (next.config.ts sends / to the matching language,
# so the English domain does not open in Slovak).
NEXT_PUBLIC_SITE_URL_CZ=https://pududotoho.cz
NEXT_PUBLIC_SITE_URL_EN=https://www.puduindustrial.com
NEXT_PUBLIC_SITE_URL_DE=https://www.puduindustrial.de


# --- Content tooling at /admin -----------------------------------------------
# Without these two the tools refuse to open rather than running unauthenticated.
#
# The publishable key belongs in the browser: sign-ups are disabled, so the list
# of Supabase users is the access list. The project never uses the secret
# (service role) key — do not add it here or to the hosting environment.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side Supabase access, used only for the settings table that holds the
# outgoing mail password. That table has RLS enabled with no policies, so the
# publishable key cannot reach it at all. Never expose this with a NEXT_PUBLIC_
# prefix — it bypasses row level security.
SUPABASE_SECRET_KEY=

# Connection string for `npm run db:migrate` (Supabase → Project settings →
# Database → Connection string → Session pooler). Needed only when applying
# migrations, never at runtime.
SUPABASE_DB_URL=

# Comma separated e-mails allowed into /admin. A valid Supabase session is not
# enough — this list decides, and an empty list lets nobody in. Server side only,
# so the browser never sees who is on it.
ADMIN_EMAILS=

# Fine-grained GitHub token used by the publish action to commit the regenerated
# translation files. Repository access: this repository only, Contents:
# read & write. Server side only — never exposed with a NEXT_PUBLIC_ prefix.
GITHUB_TOKEN=
GITHUB_REPO=dusanpecko/pudu
GITHUB_BRANCH=main

# --- Analytics ------------------------------------------------------------
# Umami is cookieless. Set the website id in the PRODUCTION environment only —
# development and preview deployments then stay out of the statistics.
# NEXT_PUBLIC_UMAMI_SRC is optional and only needed for a self-hosted instance.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Contact form ------------------------------------------------------------
# Salt for the visitor hashes the rate limiter counts by. No IP address is ever
# stored — only SHA-256(pepper + address) — but without a pepper that hash is
# worthless: an IPv4 address has four billion possible values and brute-forces in
# seconds. Optional: unset, one is derived from SUPABASE_SECRET_KEY instead.
ENQUIRY_IP_PEPPER=

# Shared secret for the scheduled deletion of expired enquiries. Vercel sends it
# as `Authorization: Bearer …` to the job in vercel.json; without it the route
# refuses to run rather than leaving a public write endpoint open. Any long random
# string will do.
CRON_SECRET=
# The tracker reports only from the canonical hostnames above, so every market
# domain has to be configured there or its visits are dropped.

# Read access for the /admin dashboard. Server side only: this key can read every
# website in the Umami account, so it must never carry a NEXT_PUBLIC_ prefix.
# Separate from the tracking id, so statistics can be viewed from an environment
# that does not itself send data.
UMAMI_API_KEY=
UMAMI_WEBSITE_ID=
