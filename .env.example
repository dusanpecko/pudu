# Canonical origins. No trailing slash. Both are read at build time, so a
# change needs a redeploy.

# Primary domain — used by the Slovak and English versions, robots.txt and as
# the fallback for everything else. Without it the build falls back to
# VERCEL_PROJECT_PRODUCTION_URL, and to http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=https://pududotoho.sk

# Czech domain. Set this only in production, where both domains exist — leaving
# it unset keeps development and preview deployments on a single host.
NEXT_PUBLIC_SITE_URL_CZ=https://pududotoho.cz


# --- Content tooling at /admin -----------------------------------------------
# Without these two the tools refuse to open rather than running unauthenticated.
#
# The publishable key belongs in the browser: sign-ups are disabled, so the list
# of Supabase users is the access list. The project never uses the secret
# (service role) key — do not add it here or to the hosting environment.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Comma separated e-mails allowed into /admin. A valid Supabase session is not
# enough — this list decides, and an empty list lets nobody in. Server side only,
# so the browser never sees who is on it.
ADMIN_EMAILS=

# Fine-grained GitHub token used by the publish action to commit the regenerated
# translation files. Repository access: this repository only, Contents:
# read & write. Server side only — never exposed with a NEXT_PUBLIC_ prefix.
GITHUB_TOKEN=
GITHUB_REPO=dusanpecko/pudu
GITHUB_BRANCH=main
